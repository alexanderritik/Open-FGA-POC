    },
    {
      "id": "el00134854",
      "type": "text",
      "x": 48,
      "y": 788,
      "width": 1064,
      "height": 114,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1617831997,
      "version": 1,
      "versionNonce": 292719825,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789364614935,
      "link": null,
      "locked": false,
      "text": "This PoC's proof: a single grant at client:govt-of-india#viewer automatically reaches every zone,\nnested zone, and structure beneath it \u2014 no per-resource role, and no code change when the hierarchy grows.",
      "fontSize": 15,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "el00126011",
      "originalText": "This PoC's proof: a single grant at client:govt-of-india#viewer automatically reaches every zone,\nnested zone, and structure beneath it \u2014 no per-resource role, and no code change when the hierarchy grows.",
      "lineHeight": 1.25,
      "baseline": 13
    }
