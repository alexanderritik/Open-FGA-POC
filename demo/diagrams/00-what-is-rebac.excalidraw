      "locked": false
    },
    {
      "id": "el00057313",
      "type": "text",
      "x": 48,
      "y": 258,
      "width": 484,
      "height": 244,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2018210299,
      "version": 1,
      "versionNonce": 1134892930,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789364614935,
      "link": null,
      "locked": false,
      "text": "Traditional RBAC\n\n\u2022 Permissions attach to a role\n  (admin, editor, viewer)\n\u2022 A role is usually global, or per\n  resource-type \u2014 not per single\n  resource instance\n\u2022 Breaks down when one user needs\n  different access to different\n  individual resources, or access\n  that should flow through a deep,\n  changing hierarchy",
      "fontSize": 15,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "el00043324",
      "originalText": "Traditional RBAC\n\n\u2022 Permissions attach to a role\n  (admin, editor, viewer)\n\u2022 A role is usually global, or per\n  resource-type \u2014 not per single\n  resource instance\n\u2022 Breaks down when one user needs\n  different access to different\n  individual resources, or access\n  that should flow through a deep,\n  changing hierarchy",
      "lineHeight": 1.25,
      "baseline": 13
    },
    {
      "id": "el00065111",
      "type": "rectangle",
      "x": 620,
