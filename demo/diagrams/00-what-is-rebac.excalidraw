    },
    {
      "id": "el00036791",
      "type": "text",
      "x": 48,
      "y": 98,
      "width": 1064,
      "height": 104,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2094074998,
      "version": 1,
      "versionNonce": 1963829398,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789364614935,
      "link": null,
      "locked": false,
      "text": "ReBAC (Relationship-Based Access Control)\n\nAccess is decided by the RELATIONSHIP between a user and a resource (or between resources) \u2014\nnot by a role name. e.g. \"is this user a viewer of this zone, or of its parent project/client?\"",
      "fontSize": 16,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "el00028700",
      "originalText": "ReBAC (Relationship-Based Access Control)\n\nAccess is decided by the RELATIONSHIP between a user and a resource (or between resources) \u2014\nnot by a role name. e.g. \"is this user a viewer of this zone, or of its parent project/client?\"",
      "lineHeight": 1.25,
      "baseline": 14
    },
    {
      "id": "el00043324",
      "type": "rectangle",
      "x": 40,
      "y": 250,
      "width": 500,
      "height": 260,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 1383378599,
      "version": 1,
