      "link": null,
      "locked": false,
      "text": "What is ReBAC, and why do we need it?",
      "fontSize": 24,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "What is ReBAC, and why do we need it?",
      "lineHeight": 1.25,
      "baseline": 21
    },
    {
      "id": "el00028700",
      "type": "rectangle",
