      "locked": false
    },
    {
      "id": "el00073236",
      "type": "text",
      "x": 628,
      "y": 258,
      "width": 484,
      "height": 244,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 363246129,
      "version": 1,
      "versionNonce": 1547830470,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789364614935,
      "link": null,
      "locked": false,
      "text": "ReBAC (OpenFGA)\n\n\u2022 A permission IS a relationship\n  tuple: (user, relation, object)\n\u2022 A grant is scoped to one specific\n  resource instance (this zone,\n  this client) \u2014 not a role name\n\u2022 Inheritance follows the real\n  hierarchy: grant once at a\n  client/project/zone and it flows\n  down automatically",
      "fontSize": 15,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "el00065111",
      "originalText": "ReBAC (OpenFGA)\n\n\u2022 A permission IS a relationship\n  tuple: (user, relation, object)\n\u2022 A grant is scoped to one specific\n  resource instance (this zone,\n  this client) \u2014 not a role name\n\u2022 Inheritance follows the real\n  hierarchy: grant once at a\n  client/project/zone and it flows\n  down automatically",
      "lineHeight": 1.25,
      "baseline": 13
    },
