    },
    {
      "id": "el00115849",
      "type": "text",
      "x": 48,
      "y": 558,
      "width": 1064,
      "height": 174,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1406559158,
      "version": 1,
      "versionNonce": 1083363241,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789364614935,
      "link": null,
      "locked": false,
      "text": "Choose ReBAC (OpenFGA) over plain RBAC when:\n\n\u2022 Sharing must be fine-grained and resource-specific (\"this exact zone\", not \"all zones\")\n\u2022 Permissions must flow through a deep, possibly-changing hierarchy (client \u2192 project \u2192 zone \u2192 zone \u2192 structure)\n\u2022 A fixed set of roles can't express it without exploding into hundreds of one-off roles",
      "fontSize": 16,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "el00108640",
      "originalText": "Choose ReBAC (OpenFGA) over plain RBAC when:\n\n\u2022 Sharing must be fine-grained and resource-specific (\"this exact zone\", not \"all zones\")\n\u2022 Permissions must flow through a deep, possibly-changing hierarchy (client \u2192 project \u2192 zone \u2192 zone \u2192 structure)\n\u2022 A fixed set of roles can't express it without exploding into hundreds of one-off roles",
      "lineHeight": 1.25,
      "baseline": 14
    },
