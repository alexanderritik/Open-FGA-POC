      "isDeleted": false,
      "boundElements": [],
      "updated": 1789366578643,
      "link": null,
      "locked": false,
      "text": "One OpenFGA deployment, many applications\n\n• Each application (or environment) gets its own store_id — fully isolated data\n• Each store can run its own authorization model — apps don't share a model\n• A mobile app plugs in the same way: same OpenFGA API, its own store_id/model_id\n• Onboarding a new application needs zero changes to OpenFGA itself",
      "fontSize": 15,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "el00076007",
      "originalText": "One OpenFGA deployment, many applications\n\n• Each application (or environment) gets its own store_id — fully isolated data\n• Each store can run its own authorization model — apps don't share a model\n• A mobile app plugs in the same way: same OpenFGA API, its own store_id/model_id\n• Onboarding a new application needs zero changes to OpenFGA itself",
      "lineHeight": 1.25,
      "baseline": 13,
      "index": "a7",
      "autoResize": true
    }
