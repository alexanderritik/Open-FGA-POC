# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8002

# Application PostgreSQL (business data only)
DATABASE_URL=postgresql+psycopg://app_user:app_password@localhost:5432/app_db

# OpenFGA (authorization data only)
FGA_API_URL=http://localhost:8080
FGA_STORE_ID=
FGA_MODEL_ID=

# OpenFGA internal PostgreSQL (used only by the openfga service itself,
# never accessed directly by the FastAPI application)
OPENFGA_DATASTORE_URI=postgres://openfga_user:openfga_password@localhost:5433/openfga_db?sslmode=disable
