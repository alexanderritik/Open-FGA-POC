# --- Application (FastAPI) ---
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8002

# --- Application PostgreSQL (business data only: users, clients, projects, structures, audit_events) ---
APP_DB_USER=app_user
APP_DB_PASSWORD=app_password
APP_DB_NAME=app_db
APP_DB_PORT=5432
DATABASE_URL=postgresql+psycopg://app_user:app_password@localhost:5432/app_db

# --- OpenFGA's internal PostgreSQL (owned by OpenFGA; never accessed directly by the app) ---
FGA_DB_USER=openfga_user
FGA_DB_PASSWORD=openfga_password
FGA_DB_NAME=openfga_db
FGA_DB_PORT=5434

# --- OpenFGA server (authorization data only) ---
FGA_API_PORT=8080
FGA_GRPC_PORT=8081
FGA_PLAYGROUND_PORT=3000
FGA_API_URL=http://localhost:8080
FGA_STORE_ID=
FGA_MODEL_ID=
